<!doctype html>
<html lang="{{ lang or site.lang or 'en' }}">

    {% include "head.njk" %}

    <body class="home">
        <div class="site-container">
            <div class="site-grid">
                {% include "header.njk" %}
                <main class="content">

                    {# Masthead h-card: the identity compressed to a strip. The long
                       bio lives on /bio.html — this is the one line that says what
                       the throughline is. rel=me links stay here (plus the
                       <link rel="me"> pair in head.njk) for IndieWeb identity. #}
                    <section class="home-primary h-card">
                        <img class="home-primary__avatar u-photo" src="/img/favicon.png" alt="" width="72" height="72">
                        <div class="home-primary__text">
                            <p class="home-primary__name">
                                <a rel="me" class="u-url p-name" href="/">{{ site.author.name }}</a>
                                <span class="home-primary__meta">he/him · <span class="p-locality">Tampa, FL</span></span>
                            </p>
                            <div class="home-primary__note p-note">
                                {{ content | safe }}
                            </div>
                            <ul class="profiles">
                                {% if site.github_username %}
                                    <li><a href="https://github.com/{{ site.github_username }}" rel="me">GitHub</a></li>
                                {% endif %}
                                <li><a rel="me" href="https://bsky.app/profile/michaelbishop.me">Bluesky</a></li>
                                <li><a rel="me" href="https://fed.brid.gy/r/https://michaelbishop.me/">Fediverse</a></li>
                                {% if site.email %}
                                    <li><a class="u-email" href="mailto:{{ site.email }}">Email</a></li>
                                {% endif %}
                                <li><a href="/feed.xml">Feed</a></li>
                            </ul>
                        </div>
                    </section>

                    <div class="earworm">
                        <latest-earworm handle="michaelbishop.me" did="did:plc:ulxk572dnu5v56yssqyupulk" player>
                            <p class="earworm__fallback">No earworm this week &mdash; here&rsquo;s
                                <a href="/listening.html">what I&rsquo;ve been listening to</a>.</p>
                        </latest-earworm>
                        <script type="module" src="https://latestearworm.com/embed.js"></script>
                    </div>

                    {# The stream. archivePosts is already every post type, newest
                       first, so prints and photos join it with no extra wiring. #}
                    <section class="stream h-feed">
                        <h2 class="stream__heading eyebrow p-name">The log</h2>
                        {%- for post in collections.archivePosts | head(10) -%}
                            {% set item = post %}
                            {% set itemBody = post.content | stripBridgyLinks | unfurlUrls %}
                            {% include "entry.njk" %}
                        {%- endfor -%}
                        <p class="stream__more">
                            <a href="/archives/">All {{ collections.archivePosts | length }} entries<span aria-hidden="true"> &rarr;</span></a>
                        </p>
                    </section>

                </main>

                {% include "footer.njk" %}
            </div>
        </div>
        {% getBundle "fontawesome" %}
    </body>
</html>
